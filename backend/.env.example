# ============================================================
# DESARROLLO (tu computadora + PostgreSQL en Docker)
# Copia este archivo como .env:   copy .env.example .env
# Para produccion (Vercel + Neon) mira .env.production.example
# ============================================================
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=citas_medicas
JWT_SECRET=admin123
JWT_EXPIRES_IN=8h
PORT=8080
# [Mejoras] Zona horaria de la sesion de PostgreSQL (opcional)
DB_TIMEZONE=America/Guatemala
# [Despliegue] Origen del frontend que puede llamar al API
CORS_ORIGINS=http://localhost:4200
