# ============================================================
# [Despliegue] PRODUCCION (Vercel + Neon)
# Estas variables NO van en un archivo: se escriben en Vercel, en el proyecto del backend:
#   Settings > Environment Variables  (marcar "Production")
# Nunca subas a GitHub los valores reales.
# ============================================================

# Cadena de conexion de Neon (la que termina en ?sslmode=require).
# Usa la conexion "pooled" (el host lleva -pooler) para el backend.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Cadena larga y aleatoria (32 caracteres o mas). No uses la de desarrollo.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Direccion del frontend en Vercel. Con * se aceptan tambien las vistas previas.
CORS_ORIGINS=https://amaticlinic.vercel.app,https://amaticlinic-*.vercel.app

# true solo en el PRIMER despliegue (crea las tablas). Despues cambialo a false y vuelve a desplegar.
DB_SYNCHRONIZE=true
